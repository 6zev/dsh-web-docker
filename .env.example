# Copy to .env and adjust. Compose reads this automatically.
#
#   cp .env.example .env
#
# Never commit .env -- it holds the proxy password.

# Image to run. Use a version tag, not :latest, so restarts cannot silently
# move you to a different DSH release.
DSH_IMAGE=ghcr.io/6zev/dsh-web:dsh-0.2.2-rc.5

# Host port to publish on. The container always listens on 3080 internally.
HOST_PORT=3080

# --- Proxy authentication -------------------------------------------------
# Enabled only when BOTH are set. Leave both empty to run with no auth, which
# is only reasonable on a trusted local network.
#
# The DSH web UI can execute code inside the container, so anything reachable
# from a network you do not control should have these set.
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Internal ports -------------------------------------------------------
# Change only if something inside the image already uses the defaults.
# DSH_PORT must differ from PROXY_PORT: one process per port.
DSH_PORT=3079
PROXY_PORT=3080

# --- Reaching the UI via a hostname ---------------------------------------
# Leave empty for http://localhost:3080.
# Set when the UI is reached through a real hostname, e.g.:
#   DSH_TRUSTED_HOSTS=app.example.com
# A full URL is also accepted -- the scheme is stripped with a warning:
#   DSH_TRUSTED_HOSTS=https://app.example.com/
# Include the port when it is not the scheme default: app.example.com:8443.
# Several accepted authorities can be comma-separated; the FIRST one is the
# authority browsers should use and the one the session cookie is minted for.
#   DSH_TRUSTED_HOSTS=app.example.com,app.internal:8443
# Without this, the session cookie is minted for loopback and the browser
# reloads forever. It also makes the proxy refuse any other Host with 421,
# including on "/", because DSH's own fence only guards /api.
DSH_TRUSTED_HOSTS=

# Advertised browser-facing root, passed to dsh as --public-url.
# Required behind any reverse proxy (Cloudflare, Traefik, nginx): without it
# dsh advertises its loopback URL and the realtime channel reconnects forever.
# When empty it is derived as https://<first DSH_TRUSTED_HOSTS entry>/.
# Set it explicitly for http, a non-standard port, or a mount prefix /ui/.
DSH_PUBLIC_URL=

# WebSocket heartbeat (ms). DSH sends no pings, so Cloudflare (~100s) and
# Traefik/nginx (~60s) reap an idle realtime channel; the proxy pings every
# interval to keep it alive. 0 disables it.
PROXY_WS_PING_INTERVAL_MS=30000

# DSH_TOKEN / DSH_TOKEN_FILE are intentionally NOT listed here: they cannot
# set dsh's launch token (upstream has no --token flag; it mints a random one
# per process). The proxy scrapes the token from the dsh log. Only set them
# as a fallback while dsh is still booting, and expect them to go stale at
# the first restart -- see README.

# Opt out of DSH telemetry. Any non-empty value disables it.
DSH_TELEMETRY_DISABLED=1
