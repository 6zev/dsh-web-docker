# Copy to .env and adjust. Compose reads this automatically.
#
#   cp .env.example .env
#
# Never commit .env -- it holds the proxy password.

# Image to run. Use a version tag, not :latest, so restarts cannot silently
# move you to a different DSH release.
DSH_IMAGE=ghcr.io/6zev/dsh-web:dsh-0.2.1-rc.2

# Host port to publish on. The container always listens on 3080 internally.
HOST_PORT=3080

# --- Proxy authentication -------------------------------------------------
# Enabled only when BOTH are set. Leave both empty to run with no auth, which
# is only reasonable on a trusted local network.
#
# The DSH web UI can execute code inside the container, so anything reachable
# from a network you do not control should have these set.
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Internal ports -------------------------------------------------------
# Change only if something inside the image already uses the defaults.
# DSH_PORT must differ from PROXY_PORT: one process per port.
DSH_PORT=3079
PROXY_PORT=3080

# --- Reaching the UI via a hostname ---------------------------------------
# Leave empty for http://localhost:3080.
# Set when the UI is reached through a real hostname, e.g.:
#   DSH_TRUSTED_HOSTS=app.example.com
# Include the port when it is not the scheme default: app.example.com:8443.
# Several accepted authorities can be comma-separated; the FIRST one is the
# authority browsers should use and the one the session cookie is minted for.
#   DSH_TRUSTED_HOSTS=app.example.com,app.internal:8443
# Without this, the session cookie is minted for loopback and the browser
# reloads forever.
DSH_TRUSTED_HOSTS=

# Opt out of DSH telemetry. Any non-empty value disables it.
DSH_TELEMETRY_DISABLED=1
